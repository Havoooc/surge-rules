#!name=酷安去广告
#!desc=过滤已知首页赞助卡片与搜索推广；详情、评论与商品关联原样放行。开屏效果取决于启动接口。
#!author=Havoooc
#!category=去广告
#!homepage=https://github.com/Havoooc/surge-rules
#!icon=https://raw.githubusercontent.com/zirawell/R-Store/main/Res/Icon/App/coolapk.png
#!date=2026-09-30

[Map Local]
# 搜索页面热搜推荐词与商业推广
^https:\/\/api\.coolapk\.com\/v\d+\/search\?.*type=hotSearch data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Script]
# 启动配置与分页信息流净化；首页 main/indexV* 推荐大响应不经脚本处理，避免拖慢内容展示。
酷安-首页净化 = type=http-response,pattern=^https?:\/\/api\.coolapk\.com\/v\d+\/(?:main\/(?:init|dataList)|dataList)(?:\?.*)?$,requires-body=1,max-size=3145728,timeout=5,script-path=https://raw.githubusercontent.com/Havoooc/surge-rules/main/scripts/coolapk-adblock.js

[MITM]
hostname = %APPEND% api.coolapk.com
