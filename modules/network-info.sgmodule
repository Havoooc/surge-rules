#!name=网络信息面板
#!desc=实时显示网络环境、SSID/内网IP、国内直连与代理落地出口、ISP运营商及真实延迟测速；支持网络变动后台提醒与隐私打码。
#!author=Havoooc；原作者 @xream @keywos
#!category=工具
#!homepage=https://github.com/Havoooc/surge-rules
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Network.png
#!date=2026-09-20
#!arguments=MASK:1,IPv6:0,NOTIFY:1,RTT:1,UPDATE-INTERVAL:-1,ICON:globe.asia.australia,ICON-COLOR:#007AFF
#!arguments-desc=- MASK: 是否打码保护IP地址 [1: 开启(推荐), 0: 关闭]\n- IPv6: 是否显示IPv6地址 [1: 开启, 0: 关闭]\n- NOTIFY: 网络变化时是否发送系统通知 [1: 开启, 0: 关闭]\n- RTT: 是否测速显示真实延迟 [1: 开启, 0: 关闭]\n- UPDATE-INTERVAL: 面板刷新间隔(秒)，默认 -1 表示点击或进入App时刷新\n- ICON: 面板图标 (SF Symbol)\n- ICON-COLOR: 面板图标颜色 (#007AFF 等)

[Script]
# 网络变动后台通知
网络信息变化 = type=event,event-name=network-changed,timeout=10,script-path=https://raw.githubusercontent.com/Havoooc/surge-rules/main/scripts/network-info.js,argument="TYPE=EVENT&MASK={{{MASK}}}&IPv6={{{IPv6}}}&NOTIFY={{{NOTIFY}}}&RTT={{{RTT}}}"

# 网络信息首页组件
网络信息面板 = type=generic,timeout=10,script-path=https://raw.githubusercontent.com/Havoooc/surge-rules/main/scripts/network-info.js,argument="MASK={{{MASK}}}&IPv6={{{IPv6}}}&NOTIFY={{{NOTIFY}}}&RTT={{{RTT}}}&ICON={{{ICON}}}&ICON-COLOR={{{ICON-COLOR}}}"

[Panel]
网络信息 = script-name=网络信息面板,update-interval={{{UPDATE-INTERVAL}}}
