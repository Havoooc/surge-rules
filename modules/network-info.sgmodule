#!name=网络信息面板
#!desc=简洁显示直连、中转、落地地区与实际策略；不展示任何 IP，并在网络状态切换时通知。
#!author=Havoooc；原作者 @xream @keywos
#!category=工具
#!homepage=https://github.com/Havoooc/surge-rules
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Network.png
#!date=2026-09-20
#!arguments=NOTIFY:1,RTT:0,PROXY-POLICY:AUTO,UPDATE-INTERVAL:-1,ICON:globe.asia.australia,ICON-COLOR:#007AFF
#!arguments-desc=- NOTIFY: 网络状态切换时是否发送通知 [1: 开启(默认), 0: 关闭]\n- RTT: 是否显示国内与代理延迟 [1: 开启, 0: 关闭(默认)]\n- PROXY-POLICY: 代理探测策略，AUTO 表示按现有规则分流，也可填写策略组名称\n- UPDATE-INTERVAL: 面板刷新间隔(秒)，默认 -1 表示点击或进入App时刷新\n- ICON: 面板图标 (SF Symbol)\n- ICON-COLOR: 面板图标颜色 (#007AFF 等)

[Script]
# 网络变动后台通知
网络信息变化 = type=event,event-name=network-changed,timeout=10,script-path=https://raw.githubusercontent.com/Havoooc/surge-rules/main/scripts/network-info.js,argument="TYPE=EVENT&NOTIFY={{{NOTIFY}}}&RTT={{{RTT}}}&PROXY-POLICY={{{PROXY-POLICY}}}"

# 网络信息首页组件
网络信息面板 = type=generic,timeout=10,script-path=https://raw.githubusercontent.com/Havoooc/surge-rules/main/scripts/network-info.js,argument="NOTIFY={{{NOTIFY}}}&RTT={{{RTT}}}&PROXY-POLICY={{{PROXY-POLICY}}}&ICON={{{ICON}}}&ICON-COLOR={{{ICON-COLOR}}}"

[Panel]
网络信息 = script-name=网络信息面板,update-interval={{{UPDATE-INTERVAL}}}
