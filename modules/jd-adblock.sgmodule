#!name=京东去广告
#!desc=移除开屏、首页运营推广与“我的”页面推广；订单页仅清理广告字段，不拦截登录、下单、支付和京东金融接口。
#!author=Havoooc（基于 RuCu6、Maasea 规则优化）
#!category=去广告
#!tag=京东,去广告
#!homepage=https://github.com/Havoooc/surge-rules

[Rule]
URL-REGEX,^http:\/\/\w{32}\.jddebug\.com\/diagnose\?,REJECT

[Body Rewrite]
# 关闭京东 App 的 HTTPDNS 配置，使请求继续由 Surge DNS 与规则系统处理。
http-response-jq ^https:\/\/api\.m\.jd\.com\/client\.action\?functionId=basicConfig 'if getpath(["data","JDMessage","socketmonitor","isSocketEstablishedAhead"]) != null then setpath(["data","JDMessage","socketmonitor","isSocketEstablishedAhead"]; 0) else . end'
http-response-jq ^https:\/\/api\.m\.jd\.com\/client\.action\?functionId=basicConfig 'if getpath(["data","JDMessage","socketmonitor","isSocketReport"]) != null then setpath(["data","JDMessage","socketmonitor","isSocketReport"]; 0) else . end'
http-response-jq ^https:\/\/api\.m\.jd\.com\/client\.action\?functionId=basicConfig 'if getpath(["data","JDHttpToolKit","httpdns","httpdns"]) != null then setpath(["data","JDHttpToolKit","httpdns","httpdns"]; 0) else . end'

[Map Local]
# 热词、站点拉取、首页推荐、开屏和运营广告位。
^https:\/\/api\.m\.jd\.com\/client\.action\?functionId=(searchBoxWord|stationPullService|uniformRecommend[06]|homeAreaPop|home_launchConfig|lite_advertising|queryMaterialAdverts|smart_delivery_strategy)(?:&.*)?$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Script]
# 仅处理已知广告/运营接口；响应非 JSON 或字段结构变化时原样放行。
jd-adblock = type=http-response,pattern=^https:\/\/api\.m\.jd\.com\/client\.action\?functionId=(deliverLayer|getTabHomeInfo|myOrderInfo|orderTrackBusiness|personinfoBusiness|start|welcomeHome)(?:&.*)?$,requires-body=1,max-size=3145728,timeout=20,script-path=https://raw.githubusercontent.com/Havoooc/surge-rules/main/scripts/jd-adblock.js

[MITM]
hostname = %APPEND% api.m.jd.com
