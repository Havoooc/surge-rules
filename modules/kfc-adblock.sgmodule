#!name=肯德基去广告
#!desc=精准移除肯德基开屏海报与首页营销弹窗；杜绝误杀登录网关与鉴权配置，保障正常登录、自助点餐及支付。
#!author=Havoooc；参考开源社区规则优化
#!category=去广告
#!homepage=https://github.com/Havoooc/surge-rules
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Advertising.png
#!date=2026-09-29

[General]
# 避免百胜登录鉴权与验证码接口受到 Fake-IP 干扰
always-real-ip = %APPEND% *.kfc.com.cn

[Map Local]
# 精准拦截开屏海报与明确广告资源，杜绝使用通配 .*\.json 避免误杀登录组件配置
^https?:\/\/res\.kfc\.com\.cn\/advertisement\/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https?:\/\/res\.kfc\.com\.cn\/CRM\/kfcad\/custom_v\d*\/wxapp data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https?:\/\/res\.kfc\.com\.cn\/CRM\/kfcad\/apphome\d*\/apphome data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[MITM]
hostname = %APPEND% res.kfc.com.cn
