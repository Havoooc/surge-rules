#!name=航旅纵横去广告（稳定版）
#!desc=移除航旅纵横开屏与首页广告；已排除可能误杀正常页面的首页横幅素材规则
#!author=Havoc
#!homepage=https://github.com/Havoooc/surge-rules
#!openUrl=https://apps.apple.com/app/id480161784
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Umetrip.png
#!date=2026-08-07

[Rule]

# 开屏配置与废弃广告接口
DOMAIN,startup.umetrip.com,REJECT
DOMAIN,discardrp.umetrip.com,REJECT

# 广告统计与传感器上报
DOMAIN,analytics.umetrip.com,REJECT
DOMAIN,sensors.umetrip.com.cn,REJECT

[Script]

# 根据 Rpid 精准拒绝已知广告位；修正旧规则无法匹配 HTTPS 的问题
移除航旅纵横广告 = type=http-request, pattern=^https?:\/\/(?:114\.115\.217\.129|(?:bkclient|umerp|home)\.umetrip\.com(?:\.cn)?)\/gateway\/api\/umetrip\/native(?:\?.*)?$, script-path=https://raw.githubusercontent.com/Havoooc/surge-rules/main/scripts/umetrip-remove-ads.js, requires-body=false, timeout=10

[MITM]

hostname = %APPEND% 114.115.217.129, home.umetrip.com, umerp.umetrip.com, umerp.umetrip.com.cn, bkclient.umetrip.com, bkclient.umetrip.com.cn
