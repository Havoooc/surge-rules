#!name=东方财富去广告
#!desc=精确处理东方财富广告配置接口，拦截明确广告素材与追踪；保留共享图片目录，更新后请冷启动 App
#!author=Havoc
#!homepage=https://github.com/Havoooc/surge-rules
#!icon=https://is1-ssl.mzstatic.com/image/thumb/Purple211/v4/80/c7/51/80c75169-8b9d-602a-7c4d-c356bf456282/AppIcon-0-0-1x_U007ephone-0-11-0-0-sRGB-85-220.png/512x512bb.jpg?v=eastmoney-20261026
#!date=2026-10-26

[Rule]

# 保留既有独立广告域拦截；两个 infoService 域名改由下方精确 Map Local 处理。
DOMAIN,emdcadvise.eastmoney.com,REJECT

# 已被多套公开规则收录的广告、推广和统计域名
DOMAIN,bduserlog.eastmoney.com,REJECT
DOMAIN,js4.eastmoney.com,REJECT
DOMAIN,same.eastmoney.com,REJECT
DOMAIN,cp2.eastmoney.com,REJECT

[Map Local]

# 已有上游规则覆盖的广告配置接口；返回有效空 JSON，其余路径不拦截。
# 来源：FFDNS eastmoney_splash_ad_block.plugin、fmz200 DongFangCaiFu.snippet。
^https?:\/\/emdcadvertise(?:pj)?\.eastmoney\.com\/infoService\/v[0-9]+(?:[/?]|$) data-type=text data="{}" status-code=200

# 明确广告素材目录返回空对象；是否减少重试需实际 App 验证
^https?:\/\/swdlcdn\.eastmoney\.com\/app\/adimg\/ data-type=text data="{}" status-code=200

# 常见活动广告素材目录
^https?:\/\/swdlcdn\.eastmoney\.com\/(?:app\/)?(?:advert|advertise|advertisement)\/ data-type=tiny-gif status-code=200

# Choice 组件启动广告
^https?:\/\/choicegw2\.eastmoney\.com\/ads\/userauth\/api\/Ad\/GetLaunchAd(?:\?.*)?$ data-type=text data="{}" status-code=200


[MITM]

hostname = %APPEND% emdcadvertise.eastmoney.com, emdcadvertisepj.eastmoney.com, swdlcdn.eastmoney.com, choicegw2.eastmoney.com
