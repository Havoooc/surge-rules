#!name=网易云音乐去广告
#!desc=移除网易云音乐开屏广告、首页信息流推广、搜索广告营销词、侧栏营销弹窗与会员弹窗；保留登录、播放、下载、歌单、评论与社交功能。
#!author=Havoooc；参考 ddgksf2013 规则
#!category=去广告
#!homepage=https://github.com/Havoooc/surge-rules
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Netease_Music.png
#!date=2026-09-29

[Rule]
# 广告素材 CDN 与追踪上报域名
DOMAIN-SUFFIX,iadmat.nosdn.127.net,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,iadmatvideo.nosdn.127.net,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,iadmusicmat.music.126.net,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,iadmusicmatvideo.music.126.net,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,gmacloud.nosdn.127.net,REJECT,extended-matching,pre-matching

[Map Local]
# 活动推广与营销弹窗（快速静默返回）
^https?:\/\/interface\d?\.music\.163\.com\/e?api\/content\/activity\/music\/jar\/template\/list data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https?:\/\/interface\d?\.music\.163\.com\/e?api\/sp\/flow\/popup\/query data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https?:\/\/interface\d?\.music\.163\.com\/e?api\/vipmall\/couponcfg\/get data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https?:\/\/interface\d?\.music\.163\.com\/w?eapi\/(?:resource-exposure\/)?activity data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https?:\/\/interface\d?\.music\.163\.com\/e?api\/comment\/feed\/inserted\/resources data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https?:\/\/interface\d?\.music\.163\.com\/e?api\/resource-exposure\/config data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Script]
# 框架区：底部 Tab、发现页、推荐页、强制更新弹窗
网易云-框架净化 = type=http-response,pattern=^https?:\/\/interface\d?\.music\.163\.com\/e?api\/(?:link\/home\/framework\/tab|link\/page\/(?:discovery|rcmd)\/resource\/show|ios\/upgrade\/get),requires-body=1,max-size=0,timeout=15,script-path=https://gist.githubusercontent.com/ddgksf2013/4f53b7c6083678df25fecc8ff68b52c4/raw/dbbc85975ab0e2d4b7494b594fa0d85e69709248/netease.adblock.js

# 搜索区：默认填词、猜你喜欢、搜索 Chart、相关搜索、特殊词
网易云-搜索净化 = type=http-response,pattern=^https?:\/\/interface\d?\.music\.163\.com\/e?api\/search\/(?:default\/keyword\/list|rcmd\/keyword\/get|chart\/(?:list|detail)|suggest\/keyword\/get|specialkeyword\/get),requires-body=1,max-size=0,timeout=15,script-path=https://gist.githubusercontent.com/ddgksf2013/4f53b7c6083678df25fecc8ff68b52c4/raw/dbbc85975ab0e2d4b7494b594fa0d85e69709248/netease.adblock.js

# 广告区：广告加载、实时广告、广告 Get、插入广告、歌单顶部广告、弹窗免费听歌
网易云-广告净化 = type=http-response,pattern=^https?:\/\/interface\d?\.music\.163\.com\/e?api\/(?:ad\/(?:loading\/(?:get|current)|get)|link\/(?:position\/show\/resource|scene\/show\/resource)|vip\/cashier\/tspopup\/get),requires-body=1,max-size=0,timeout=15,script-path=https://gist.githubusercontent.com/ddgksf2013/4f53b7c6083678df25fecc8ff68b52c4/raw/dbbc85975ab0e2d4b7494b594fa0d85e69709248/netease.adblock.js

# 侧栏区：账户推广、侧栏推广、侧边 VIP、侧边浮层、兑换黑胶 Tips、创作福利
网易云-侧栏净化 = type=http-response,pattern=^https?:\/\/interface\d?\.music\.163\.com\/e?api\/(?:vipnewcenter\/app\/resource\/newaccountpage|side-bar\/mini-program\/music-service\/account|delivery\/(?:deliver|batch-deliver)|yunbei\/account\/entrance\/get|creator\/musician\/reminder\/message\/get),requires-body=1,max-size=0,timeout=15,script-path=https://gist.githubusercontent.com/ddgksf2013/4f53b7c6083678df25fecc8ff68b52c4/raw/dbbc85975ab0e2d4b7494b594fa0d85e69709248/netease.adblock.js

# 歌曲区：评论区插入推广（batch 聚合接口）
网易云-评论净化 = type=http-response,pattern=^https?:\/\/interface\d?\.music\.163\.com\/e?api\/batch,requires-body=1,max-size=0,timeout=15,script-path=https://gist.githubusercontent.com/ddgksf2013/4f53b7c6083678df25fecc8ff68b52c4/raw/dbbc85975ab0e2d4b7494b594fa0d85e69709248/netease.adblock.js

[MITM]
hostname = %APPEND% interface.music.163.com, interface3.music.163.com
