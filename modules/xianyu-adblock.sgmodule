#!name=闲鱼去广告
#!desc=白名单增强版：首页、社区与我的页面仅保留商品与功能卡片，移除信息流广告、开屏、搜索推广、底部推荐与工具宫格营销；装后建议清除闲鱼缓存或重装一次，以清除已缓存的开屏素材
#!author=Havoc（基于可莉公开规则优化）
#!homepage=https://github.com/Havoooc/surge-rules
#!openUrl=https://apps.apple.com/app/id510909506
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/FleaMarket.png
#!date=2026-09-20
#!requirement=SYSTEM = 'iOS'

[Rule]

# 明确的闲鱼广告素材域名；不拦截通用淘宝/阿里 HTTPDNS，避免启动重试
DOMAIN-SUFFIX,iyes.youku.com,REJECT

# 阿里 AMDC 明文 HTTP 调度（仅闲鱼 UA）：拦截后强制回落 HTTPS，保障重写命中率
AND,((URL-REGEX,"^http:\/\/.+\/amdc\/mobileDispatch"),(USER-AGENT,%E9%97%B2%E9%B1%BC*)),REJECT

[Body Rewrite]

# 删除明确广告标记，保留未识别的新卡片，降低版本更新后的误伤
http-response-jq ^https:\/\/acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlehome\.home\.nextfresh\/ '.data.homeTopList |= (if type == "array" then map(select((.sectionType? // "") == "kingkongDo")) else . end) | .data.sections |= (if type == "array" then map(select((((.data?.clickParam?.args?.cardType? // "") | tostring | test("(?i)^(homeMultiBanner|mamaAD|banner|ad|ads|advert|promotion)$")) | not) and (((.template?.name? // "") | tostring | test("(?i)(^|[_-])(ad|ads|advert|promotion|sponsor)([_-]|$)")) | not) and (((.data?.bizType? // "") | tostring | test("(?i)^(ad|homepage)$")) | not) and ( (((.template?.name? // "") | tostring) == "idlefish_home_new_commodity_card") or (((.template?.name? // "") | tostring | test("fish_home_tags_item_card"))) or (((.data?.cardTypeValue? // "") | tostring | test("(?i)^item$"))) ))) else . end)'
http-response-jq ^https:\/\/acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlehome\.widget\.refresh\.get\/ '.data.homeTopList |= (if type == "array" then map(select((.sectionType? // "") == "kingkongDo")) else . end)'
http-response-jq ^https:\/\/acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idle\.home\.whale\.modulet\/ '.data.container.sections |= (if type == "array" then map(select((((.template?.name? // "") | tostring | test("(?i)(^|[_-])(ad|ads|advert|promotion|sponsor)([_-]|$)")) | not) and (((.template?.name? // "") | tostring | test("fish_home_miniapp|fish_home_tags_item_card|idlefish_home_new_commodity_card"))))) else . end)'
http-response-jq ^https:\/\/acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idle\.fun\.follow\.feed\.list\/ '.data.sections |= (if type == "array" then map(select(((.cardType? // "") | tostring | test("(?i)^(ad|ads|advert|promotion)$") | not) and ((.template?.name? // "") | tostring | test("(?i)(^|[_-])(ad|ads|advert|promotion|sponsor)([_-]|$)") | not))) else . end)'
http-response-jq ^https:\/\/acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlehome\.home\.community\/ '.data.feedsList |= (if type == "array" then map(select(((((.template?.name? // "") | tostring) == "idlefish_home_new_commodity_card") or (((.template?.name? // "") | tostring) == "idlefish_home_new_content_card")))) else . end)'
http-response-jq ^https:\/\/acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlehome\.home\.newitem\.page\/ '.data.sections |= (if type == "array" then map(select(((.data?.clickParam?.args?.cardType? // "") | tostring | test("(?i)^(banner|mamaAD|ad|ads|advert|promotion)$") | not))) else . end)'
http-response-jq ^https:\/\/acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idle\.local\.flow\.plat\.section\/ '.data.data.components |= (if type == "array" then map(select(((.data?.template?.name? // "") | tostring | test("(?i)(^|[_-])(ad|ads|advert|promotion|sponsor)([_-]|$)") | not))) else . end)'
http-response-jq ^https:\/\/acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idle\.local\.home\.top\/ '.data.data.components |= (if type == "array" then map(select(((.data?.template?.name? // "") | tostring | test("(?i)(^|[_-])(ad|ads|advert|promotion|sponsor)([_-]|$)") | not))) else . end)'
http-response-jq ^https:\/\/acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idle\.local\.home\/ '.data.sections |= (if type == "array" then map(select(((.template?.cardEnum? // "") | tostring | test("(?i)^(ads?|advert|promotion)$") | not))) else . end)'

# 个人页白名单：仅保留头部、用户信息、交易、评价与工具区块，并清空营销提示
http-response-jq ^https:\/\/acs\.m\.goofish\.com\/gw\/mtop\.idle\.user\.page\.my\.adapter\/ '.data.container.sections |= (if type == "array" then map(select(((.template?.name? // "") | tostring | test("^my_fy[0-9]+_(header|user_info|trade|appraise|tools)$")))) | map(if (.item? | type) == "object" then .item |= (if (.level?.exContent?.tips? != null) then del(.level.exContent.tips) else . end) else . end) else . end)'
http-response-jq ^https:\/\/acs\.m\.goofish\.com\/gw\/mtop\.idle\.user\.page\.my\.adapter\/ 'if (.data.container.sections? | type) == "array" then (.data.container.sections[] |= (   if .item.tool then     .item.tool.exContent.tools = [       [         {           "targetUrl": "https://h5.m.goofish.com/wow/moyu/moyu-project/fish-ad/pages/home?kun=true&fromScene=myPage",           "exContent": {             "title": "超级擦亮",             "icon": "https://gw.alicdn.com/imgextra/i2/O1CN01bVNpPu1eGbSDs0GSR_!!6000000003844-2-tps-84-84.png",             "toolId": 23           },           "clickParam": {             "args": {               "toolId": "23"             },             "arg1": "Function"           }         },         {           "targetUrl": "https://h5.m.goofish.com/wow/moyu/moyu-project/moyu-tb-resell/pages/newResell?isNeedRefresh=0&setTab=1",           "exContent": {             "title": "淘宝转卖",             "icon": "https://gw.alicdn.com/imgextra/i2/O1CN01JTbPcx1Qrn3n9w03n_!!6000000002030-2-tps-84-84.png",             "toolId": 11           },           "clickParam": {             "args": {               "toolId": "11"             },             "arg1": "Function"           }         },         {           "targetUrl": "https://h5.m.goofish.com/wow/moyu/moyu-project/experience-officer/pages/home?kun=true",           "exContent": {             "title": "闲鱼体验官",             "icon": "https://gw.alicdn.com/imgextra/i1/O1CN016leRFv1N0Fprgaghl_!!6000000001507-2-tps-84-84.png",             "toolId": 2           },           "clickParam": {             "args": {               "toolId": "2"             },             "arg1": "Function"           }         },         {           "targetUrl": "https://h5.m.goofish.com/wow/moyu/moyu-project/seafood-qa/pages/my-content?useCusFont=true&loadingVisible=false",           "exContent": {             "title": "帖子中心",             "icon": "https://gw.alicdn.com/imgextra/i1/O1CN01Cge0QO1R2K5RfoaOw_!!6000000002053-2-tps-84-84.png",             "toolId": 13           },           "clickParam": {             "args": {               "toolId": "13"             },             "arg1": "Function"           }         }       ],       [         {           "targetUrl": "https://h5.m.goofish.com/app/msd/buyer-aqcenter/index.html?source=316#/notice",           "exContent": {             "title": "闲鱼公约",             "icon": "https://img.alicdn.com/imgextra/i4/O1CN01A9ofQ51t1EOZfykDn_!!6000000005841-2-tps-84-84.png",             "toolId": 20           },           "clickParam": {             "args": {               "toolId": "20"             },             "arg1": "Function"           }         },         {           "targetUrl": "https://h5.m.goofish.com/wow/moyu/moyu-project/cro-security-center/pages/security-center",           "exContent": {             "title": "安全中心",             "icon": "https://gw.alicdn.com/imgextra/i4/O1CN013kllih1NlQd6e3sRv_!!6000000001610-2-tps-84-84.png",             "toolId": 1           },           "clickParam": {             "args": {               "toolId": "1"             },             "arg1": "Function"           }         }       ]     ]   else     .   end )) else . end'
http-response-jq ^https:\/\/acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlehome\.home\.circle\.list\/ '.data.circleList |= (if type == "array" then map(if (.showInfo?.titleImage? | type) == "object" then .showInfo.titleImage |= (.lightUrl="" | .url="" | del(.width, .height)) else . end) else . end)'

# 搜索页广告、推广前缀、热榜与填充词
http-response-jq ^https:\/\/g-acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlemtopsearch\.search\/ '.data.resultList |= (if type == "array" then map(select(((.data?.item?.main?.exContent?.dislikeFeedback?.clickParam?.args?.bizType? // "") | tostring | test("(?i)^(ad|ads|advert|promotion)$") | not))) else . end) | del(.data.resultPrefixBar)'
http-response-jq ^https:\/\/acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlemtopsearch\.search\.discover\/ '.data.resultList |= (if type == "array" then map(select((.type? // "") != "MarketHotSpot")) else . end)'
http-response-jq ^https:\/\/acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlemtopsearch\.item\.search\.activate\/ '.data.cardList |= (if type == "array" then map(if (.cardData? | type) == "object" then .cardData |= del(.hotwords) else . end) else . end)'

[Map Local]

# 仅拦截明确广告/运营接口；保留商品推荐和购买推荐，避免重试与业务缺失
^https:\/\/(?:g-)?acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlecommerce\.splash\.ads\/ data-type=text data="{}" status-code=200 header="Content-Type: application/json"
^https:\/\/(?:g-)?acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idle\.user\.strategy\.list\/ data-type=text data="{}" status-code=200 header="Content-Type: application/json"
^https:\/\/(?:g-)?acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idle\.local\.near\.by\.corner\.info\/ data-type=text data="{}" status-code=200 header="Content-Type: application/json"
^https:\/\/(?:g-)?acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlemtopsearch\.search\.shade\/ data-type=text data="{}" status-code=200 header="Content-Type: application/json"
^https:\/\/(?:g-)?acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idle\.playboy\.recommend\/ data-type=text data="{}" status-code=200 header="Content-Type: application/json"
^https:\/\/(?:g-)?acs\.m\.goofish\.com\/gw\/mtop\.idle\.ad\.expose(?:\/|\?|$) data-type=text data="{}" status-code=200 header="Content-Type: application/json"

# 商品详情页"超好卖"推荐流（wool/可莉一致拦截）
^https:\/\/(?:g-)?acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idle\.item\.recommend\.list\/ data-type=text data="{}" status-code=200 header="Content-Type: application/json"
# "我的"页底部商品推荐（wool/可莉一致拦截）
^https:\/\/acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idle\.item\.buy\.feeds\/ data-type=text data="{}" status-code=200 header="Content-Type: application/json"

[MITM]

hostname = %APPEND% acs.m.goofish.com, g-acs.m.goofish.com
