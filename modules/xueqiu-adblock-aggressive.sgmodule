#!name=雪球去广告（激进版）
#!desc=在稳定版基础上额外移除推广配置、AI 搜索推荐、金融产品推广和弹窗；可能造成部分页面留白，请勿与稳定版同时启用
#!author=Havoc
#!homepage=https://github.com/Havoooc/surge-rules
#!date=2026-08-24

[Body Rewrite]

# 仅移除配置中的推广字段，保留其余 data 内容，避免破坏首页正常配置
http-response-jq ^https:\/\/open\.xueqiu\.com\/mpaas\/config\/content\?.*timeline_tab_name 'del(.data.im_notice_show, .data.request_notice_show, .data.timeline_tab_name, .data.profileMenuConfig_anonymous_V12, .data.trade_open_account_promotion_url, .data.trade_unify_open_account_list, .data.community_ad_download_msg, .data.home_tab_dynamic, .data.home_tab_dynamic_before, .data.home_tab_dynamic_after, .data.open_wechat_mini_app_config, .data.user_guide_contact_config, .data.brokers_router_config, .data.my_page_right_items)'

[Map Local]

# 启动页、新用户活动及应用内推广配置
^https:\/\/api\.xueqiu\.com\/snowpard\/launch_strategy\/query\.json(?:\?.*)?$ data-type=text data="{}" status-code=200 header="Content-Type: application/json"
^https:\/\/api\.xueqiu\.com\/lightsnow\/launch\/plan\/bee\/query\.json(?:\?.*)?$ data-type=text data="{}" status-code=200 header="Content-Type: application/json"
^https:\/\/open\.xueqiu\.com\/mpaas\/config\/content\?.*home_visitor_relation_config data-type=text data="{}" status-code=200 header="Content-Type: application/json"
^https:\/\/api\.xueqiu\.com\/snowpard\/ad_strategy(?:\?.*)?$ data-type=text data="{}" status-code=200 header="Content-Type: application/json"
^https:\/\/api\.xueqiu\.com\/promotion\/display_ad_batch\.json(?:\?.*)?$ data-type=text data="{}" status-code=200 header="Content-Type: application/json"
^https:\/\/api\.xueqiu\.com\/snowpard\/bomb_box\/show\.json(?:\?.*)?$ data-type=text data="{}" status-code=200 header="Content-Type: application/json"

# 自选、首页及热门活动的推广入口
^https:\/\/api\.xueqiu\.com\/lightsnow\/optional\/banner\/query\.json(?:\?.*)?$ data-type=text data="{}" status-code=200 header="Content-Type: application/json"
^https:\/\/api\.xueqiu\.com\/snowflake-theme\/query\/v1\/hot_event\/rich_tag_new\.json(?:\?.*)?$ data-type=text data="{}" status-code=200 header="Content-Type: application/json"
^https:\/\/api\.xueqiu\.com\/query\/v1\/hot_event\/tag\.json(?:\?.*)?$ data-type=text data="{}" status-code=200 header="Content-Type: application/json"
^https:\/\/open\.xueqiu\.com\/mpaas\/config\/content\?.*cube_detail_bottom_operation_trade_button data-type=text data="{}" status-code=200 header="Content-Type: application/json"

# 推荐卡片、直播、AI 搜索推荐和金融产品营销位
^https:\/\/api\.xueqiu\.com\/recommend-proxy\/card\/zj_card\.json\?feed_id=207(?:&.*)?$ data-type=text data="{}" status-code=200 header="Content-Type: application/json"
^https:\/\/api\.xueqiu\.com\/recommend-proxy\/card\/portfolio_tab_symbol\.json(?:\?.*)?$ data-type=text data="{}" status-code=200 header="Content-Type: application/json"
^https:\/\/stock\.xueqiu\.com\/v5\/stock\/group\/recommend\/default\/list\.json(?:\?.*)?$ data-type=text data="{}" status-code=200 header="Content-Type: application/json"
^https:\/\/api\.xueqiu\.com\/livestream\/structure\/live\/hotCard\.json(?:\?.*)?$ data-type=text data="{}" status-code=200 header="Content-Type: application/json"
^https:\/\/api\.xueqiu\.com\/query\/search\/ai\/v[0-9]+\/recommend_search\.json(?:\?.*)?$ data-type=text data="{}" status-code=200 header="Content-Type: application/json"
^https:\/\/api\.xueqiu\.com\/analysis\/status\/v[0-9]+\/underlying_product\.json(?:\?.*)?$ data-type=text data="{}" status-code=200 header="Content-Type: application/json"
^https:\/\/fund\.xueqiu\.com\/fundx\/activity\/x\/web\/djUser\/getBeeMaterial(?:\?.*)?$ data-type=text data="{}" status-code=200 header="Content-Type: application/json"
^https:\/\/fund\.xueqiu\.com\/fundx\/activity\/x\/web\/c\/index\/dataByCode(?:\?.*)?$ data-type=text data="{}" status-code=200 header="Content-Type: application/json"

[MITM]

hostname = %APPEND% api.xueqiu.com, open.xueqiu.com, stock.xueqiu.com, fund.xueqiu.com
