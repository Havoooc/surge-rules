#!name=Havoc全能去广告合集
#!desc=整合仓库内去广告模块、HTTPDNS 稳妥拦截与国内银行 VPN 兼容；保留独立模块以便排错和回退。
#!author=Havoooc
#!category=去广告
#!homepage=https://github.com/Havoooc/surge-rules
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Advertising.png
#!date=2026-09-20
#!arguments=贴吧隐藏推荐页视频帖子:false
#!arguments-desc=- 贴吧隐藏推荐页视频帖子：[true, false]，默认关闭。

[General]
# 国内银行 VPN 兼容（稳定版）General 部分：多个国内 App 共用的网络连通性检测
# 包括中行缤纷生活、光大及部分地方银行场景；建行、中国银行和交通银行使用公开配置中反复出现的银行域名后缀
skip-proxy = %APPEND% *.bankcomm.com, *.boc.cn, *.ccb.com, login-service.mobile-bank.psbc.com, mbank.psbc.com, mobile-bank.psbc.com, www.abchina.com.cn, www.baidu.com, yunbusiness.ccb.com
# 避免运营商登录及部分金融 App 域名受到 Fake-IP 影响
# 平安和招商银行仅加入 always-real-ip，不跳过规则策略，也不拦截业务接口
always-real-ip = %APPEND% *.cmbchina.com, *.pingan.com.cn, easy-login.10099.com.cn, id6.me, open.e.189.cn

[Rule]
# > 高德地图去广告
# 阻止 QUIC 避免穿透 MITM
AND,((PROTOCOL,UDP),(DEST-PORT,443),(DOMAIN-SUFFIX,amap.com)),REJECT-NO-DROP
# 高德专用广告素材 CDN；不拦截通用地图瓦片和 AMDC。
DOMAIN,free-aos-cdn-image.amap.com,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,v.smtcdns.com,REJECT,extended-matching,pre-matching

# > 国内银行 VPN 兼容（稳定版）
# 农业银行已公开验证的代理环境探测接口
DOMAIN,msmp.abchina.com.cn,REJECT

# 说明：
# 1. 本插件不配置 MITM，也不读取、修改或解密银行业务数据。
# 2. 对直接读取 iOS VPN 状态的 App（部分新版光大、民生等），域名规则无法稳定绕过。
# 3. 浦发公开案例显示：仅加入域名不能解决其系统代理检测，因此未加入未经验证的广泛后缀。
# 4. 若某银行仍提示 VPN，优先使用 iOS 自动化：打开该 App 时关闭 Surge，退出后重新开启。

# > 哔哩哔哩去广告
# 阻止 QUIC 避免穿透 MITM
AND,((PROTOCOL,UDP),(DEST-PORT,443),(DOMAIN-SUFFIX,bilibili.com)),REJECT-NO-DROP
AND,((PROTOCOL,UDP),(DEST-PORT,443),(DOMAIN-SUFFIX,biliapi.net)),REJECT-NO-DROP

# > 携程旅行去广告
# 携程专用广告分发域名，规则层直接阻断，不依赖 MITM。
DOMAIN,ma-adx.ctrip.com,REJECT

# > 滴滴出行去广告
DOMAIN,gwp.xiaojukeji.com,REJECT
AND,((IP-ASN,45090,no-resolve),(DEST-PORT,25641),(PROTOCOL,TCP)),REJECT
AND,((IP-ASN,55990,no-resolve),(DEST-PORT,25641),(PROTOCOL,TCP)),REJECT
AND,((IP-ASN,63646,no-resolve),(DEST-PORT,25641),(PROTOCOL,TCP)),REJECT
DOMAIN,gwpgz.diditaxi.com.cn,REJECT
DOMAIN,adtrack.xiaojukeji.com,REJECT

# > 抖音去开屏广告（稳定版）
# 明确的字节广告素材域名；不使用 pglstatp、snssdk 等宽泛关键词规则。
DOMAIN,lf-ad-ies.bytecdn.cn,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,byteadverts.com,REJECT,extended-matching,pre-matching
AND,((DOMAIN-KEYWORD,-ad-),(DOMAIN-SUFFIX,byteimg.com)),REJECT,extended-matching,pre-matching

# > 东方财富去广告（强力版）
# 广告配置服务器：直接拒绝，避免不同 App 版本 JSON 字段变化导致替换失效
DOMAIN,emdcadvertise.eastmoney.com,REJECT
DOMAIN,emdcadvertisepj.eastmoney.com,REJECT
DOMAIN,emdcadvise.eastmoney.com,REJECT

# 已被多套公开规则收录的广告、推广和统计域名
DOMAIN,bduserlog.eastmoney.com,REJECT
DOMAIN,js4.eastmoney.com,REJECT
DOMAIN,same.eastmoney.com,REJECT
DOMAIN,cp2.eastmoney.com,REJECT

# > HTTPDNS 拦截（稳妥版）
# 仅保留与核心支付、出行、通讯及流媒体无关的独立 HTTPDNS 端点。
# 这些规则不需要 MITM；被拦截的 App 会使用系统或 Surge 的 DNS 解析。
DOMAIN,dns2.q2cdn.com,REJECT
DOMAIN,httpdns.kg.qq.com,REJECT
DOMAIN,httpdns.zybang.com,REJECT
DOMAIN,httpdns.calorietech.com,REJECT

# 以下高风险服务刻意不拦截：
# 微信：dns.weixin.qq.com、aedns.weixin.qq.com
# 支付及阿里生态：amdc.alipay.com、httpdns.alicdn.com、203.107.1.0/24
# 出行与本地服务：hd.xiaojukeji.com、httpdns.meituan.com
# 流媒体：httpdns.bilivideo.com、dns.iqiyi.com、httpdns.music.163.com
# 智能家居：resolver.msg.xiaomi.net、httpdns.browser.miui.com

# > 京东去广告
# 阻止 QUIC 避免穿透 MITM
AND,((PROTOCOL,UDP),(DEST-PORT,443),(DOMAIN-SUFFIX,jd.com)),REJECT-NO-DROP
URL-REGEX,^http:\/\/\w{32}\.jddebug\.com\/diagnose\?,REJECT

# > 美团去广告（稳定增强版）
# 明确的美团广告投放域名；不拦截业务 API、定位、支付和配送域名。
DOMAIN-SUFFIX,mads.meituan.com,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,ad.e.waimai.sankuai.com,REJECT,extended-matching,pre-matching

# > 米家去广告（稳定版）
# 小米广告 SDK 配置服务
DOMAIN,sdkconfig.ad.xiaomi.com,REJECT

# > 拼多多去广告（稳定增强版）
# 广告投放和遥测域名。刻意不拦截 titan、xg、ta/th 与 QUIC，避免启动时反复重连。
DOMAIN,t-dsp.pinduoduo.com,REJECT,extended-matching,pre-matching
DOMAIN,apm.pinduoduo.com,REJECT,extended-matching,pre-matching
DOMAIN,apm-a.pinduoduo.com,REJECT,extended-matching,pre-matching
DOMAIN,meta.pinduoduo.com,REJECT,extended-matching,pre-matching
DOMAIN,meta.yangkeduo.com,REJECT,extended-matching,pre-matching

# > QQ 音乐去广告
# Tencent Music 专用广告服务
DOMAIN,adstats.tencentmusic.com,REJECT
DOMAIN,ad.tencentmusic.com,REJECT
DOMAIN,adcdn.tencentmusic.com,REJECT
DOMAIN,adcdn6.tencentmusic.com,REJECT
DOMAIN,adexpo.tencentmusic.com,REJECT
DOMAIN,adclick.tencentmusic.com,REJECT
DOMAIN,mc.tencentmusic.com,REJECT

# QQ 音乐 / 全民 K 歌广告分发与曝光上报
DOMAIN,monitor.music.qq.com,REJECT
DOMAIN,tmead.y.qq.com,REJECT
DOMAIN,tmeadbak.y.qq.com,REJECT
DOMAIN,tmeadquic.y.qq.com,REJECT
DOMAIN,tmeadcomm.y.qq.com,REJECT
DOMAIN,tmeadkg.y.qq.com,REJECT
DOMAIN,tmeadkgquic.y.qq.com,REJECT

# 不拦截 rmonitor.qq.com、stat.y.qq.com、stat6.y.qq.com 等腾讯通用服务，
# 避免将 QQ、微信等其他应用的统计、稳定性和推送链路一并阻断。

# > 什么值得买去广告（稳定版）
DOMAIN,adx-api.zdmimg.com,REJECT,extended-matching,pre-matching

# > 淘宝去广告（稳定增强版）
# 阻止 QUIC 避免穿透 MITM
AND,((PROTOCOL,UDP),(DEST-PORT,443),(DOMAIN-SUFFIX,taobao.com)),REJECT-NO-DROP
# 淘宝联盟与直通车的明确广告、点击和统计域名；不屏蔽通用淘宝业务域名。
DOMAIN-SUFFIX,simba.taobao.com,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,tunion-api.m.taobao.com,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,apoll.m.taobao.com,REJECT,extended-matching,pre-matching
DOMAIN,h-adashx.ut.taobao.com,REJECT,extended-matching,pre-matching

# > 淘宝闪购去广告（稳定版）
# 明确的广告统计与广告素材桶；不拦截淘宝闪购业务、AMDC、配送或商品图片接口。
DOMAIN,wgo.mmstat.com,REJECT,extended-matching,pre-matching
DOMAIN,h-adashx.ut.ele.me,REJECT,extended-matching,pre-matching
DOMAIN-KEYWORD,o2o-ad-dev.oss-cn,REJECT,extended-matching,pre-matching

# > 百度贴吧去广告（稳定增强版）
# 阻断贴吧广告专用地址；规则由上游维护，可随接口变化更新。
RULE-SET,https://raw.githubusercontent.com/app2smile/rules/master/rule/tieba-ad.list,REJECT-DROP

# > 航旅纵横去广告（稳定版）
# 开屏配置与废弃广告接口
DOMAIN,startup.umetrip.com,REJECT
DOMAIN,discardrp.umetrip.com,REJECT

# 广告统计与传感器上报
DOMAIN,analytics.umetrip.com,REJECT
DOMAIN,sensors.umetrip.com.cn,REJECT

# > 微信小程序去广告（稳定版）
# 微信小程序视频广告素材；拦截后激励广告不会播放，也通常不会发放奖励
# wxsnsdy.wxs.qq.com 与 wxsnsdythumb.wxs.qq.com 也用于朋友圈图片/缩略图，故不拦截。
DOMAIN,wxsmsdy.video.qq.com,REJECT

# 明确的第三方广告主机
DOMAIN,ads-shopping.shouqianba.com,REJECT
DOMAIN,ad.maoyan.com,REJECT

# > 微博去广告
# 阻止 QUIC 避免穿透 MITM
AND,((PROTOCOL,UDP),(DEST-PORT,443),(DOMAIN-SUFFIX,weibo.cn)),REJECT-NO-DROP
AND,((PROTOCOL,UDP),(DEST-PORT,443),(DOMAIN-SUFFIX,weibo.com)),REJECT-NO-DROP
# 微博广告与追踪 SDK
DOMAIN,sdkapp.uve.weibo.com,REJECT
DOMAIN,adstrategy.biz.weibo.com,REJECT
DOMAIN,kad.uve.weibo.com,REJECT

# > 闲鱼去广告（白名单增强版）
# 明确的闲鱼广告素材域名；不拦截通用淘宝/阿里 HTTPDNS，避免启动重试
DOMAIN-SUFFIX,iyes.youku.com,REJECT

# 阿里 AMDC 明文 HTTP 调度（仅闲鱼 UA）：拦截后强制回落 HTTPS，保障重写命中率
AND,((URL-REGEX,"^http:\/\/.+\/amdc\/mobileDispatch"),(USER-AGENT,%E9%97%B2%E9%B1%BC*)),REJECT

# > 小红书去广告（稳定增强版）
# 明确的小红书广告素材与广告追踪域名。
DOMAIN,ads-img-qc.xhscdn.com,REJECT,extended-matching,pre-matching
DOMAIN,ads-video-al.xhscdn.com,REJECT,extended-matching,pre-matching
DOMAIN,ads-video-qc.xhscdn.com,REJECT,extended-matching,pre-matching
DOMAIN,t-ads.xiaohongshu.com,REJECT,extended-matching,pre-matching
# 迫使小红书回退至可解密的 HTTPS/TCP，否则信息流脚本可能无法命中。
AND,((PROTOCOL,QUIC),(DOMAIN-SUFFIX,xiaohongshu.com)),REJECT-NO-DROP

[URL Rewrite]
# > 携程旅行去广告
# 开屏广告素材（保留路径规则，兼容已缓存的 URL Rewrite 配置）。
^https?:\/\/ma-adx\.ctrip\.com\/_ma\.gif(?:\?.*)?$ - reject

# 分享落地页的百度广告请求
^https?:\/\/mbd\.baidu\.com\/newspage\/api\/getmobads\?page=landingshare(?:&.*)?$ - reject

# > 拼多多去广告（稳定增强版）
# 营销素材。
^https?:\/\/images\.pinduoduo\.com\/(?:mrk|marketing_api)\/ - reject

[Map Local]
# > 高德地图去广告
# 开屏专用接口
^https:\/\/amap-aos-info-nogw\.amap\.com\/ws\/aos\/alimama\/splash_screen_rt(?:\?|$) data-type=text data="{}" status-code=200 header="Content-Type:application/json"
# m5 开屏接口交给上游脚本清零广告时间，保留响应结构，减少重试。
# 搜索广告提示、推广热词与横幅
^https:\/\/m5\.amap\.com\/ws\/shield\/search_poi\/tips_adv(?:\?|$) data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https:\/\/m5\.amap\.com\/ws\/shield\/search\/new_hotword(?:\?|$) data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https:\/\/oss\.amap\.com\/ws\/banner\/lists\/?(?:\?|$) data-type=text data="{}" status-code=200 header="Content-Type:application/json"

# > 百度网盘去广告（稳定版）
# 任务、活动、广告和推荐位
^https:\/\/pan\.baidu\.com\/api\/taskscore\/tasklist(?:\?|$) data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https:\/\/pan\.baidu\.com\/act\/api\/activityentry(?:\?|$) data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https:\/\/pan\.baidu\.com\/rest\/\d\.\d\/pcs\/adv(?:\?|$) data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https:\/\/pan\.baidu\.com\/recommend\/query\/list(?:\?|$) data-type=text data="{}" status-code=200 header="Content-Type:application/json"

# > 携程旅行去广告
# 携程 App 行程页/首页广告位；返回空 JSON，兼容 json、scjson 与后续同名接口路径。
^https?:\/\/m\.ctrip\.com\/restapi\/(?:[A-Za-z0-9_-]+\/)*tripAds(?:\?.*)?$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

# 携程微信小程序的热门活动/运营推广位。
^https?:\/\/m\.ctrip\.com\/restapi\/soa2\/12673\/(?:[A-Za-z0-9_-]+\/)*queryWeChatHotEvent(?:\?.*)?$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

# > 滴滴出行去广告
^https:\/\/res\.xiaojukeji\.com\/resapi\/activity\/mget(?:\?|$) data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https:\/\/lion\.didialift\.com\/broker\/\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https:\/\/conf\.diditaxi\.com\.cn\/homepage\/v\d+\/other\/slow\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https:\/\/ct\.xiaojukeji\.com\/agent\/v3\/feeds\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https:\/\/conf\.diditaxi\.com\.cn\/dynamic\/conf data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https:\/\/daijia\.kuaidadi\.com(:443)?\/gateway\?api=prado\.cms\.delivery\.batch data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https:\/\/daijia\.kuaidadi\.com(:443)?\/gateway\?api=prado\.cms\.AggregateDeliveryRemoteService\.aggregateDelivery data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https:\/\/daijia\.kuaidadi\.com(:443)?\/gateway\?api=lj\.c\.p\.queryLevelAndRightsStatus data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https:\/\/daijia\.kuaidadi\.com(:443)?\/gateway\?api=lj\.cos\.p\.popup data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https:\/\/htwkop-st\.xiaojukeji\.com\/gateway\?api=cms\.htw\.delivery\.batch data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https:\/\/freight\.xiaojukeji\.com\/gateway\?api=freight\.d\.core\.multiDisplayV\d data-type=text data="{}" status-code=200 header="Content-Type:application/json"

# > 抖音去开屏广告（稳定版）
# 抖音开屏广告接口。返回正常空 JSON，避免 REJECT 导致启动阶段反复重试。
^https:\/\/aweme\.snssdk\.com\/api\/ad\/(?:\?.*)?$ data-type=text data="{\"data\":[]}" status-code=200 header="Content-Type:application/json"
^https:\/\/api5-normal-(?:lq|m)\.amemv\.com\/api\/ad\/(?:\?.*)?$ data-type=text data="{\"data\":[]}" status-code=200 header="Content-Type:application/json"
^https:\/\/zlink\.ugsdk\.cn\/ad\/(?:\?.*)?$ data-type=text data="{\"data\":[]}" status-code=200 header="Content-Type:application/json"

# > 东方财富去广告（强力版）
# 主广告素材目录返回空对象，避免 App 因连接失败重复请求
^https?:\/\/swdlcdn\.eastmoney\.com\/app\/adimg\/ data-type=text data="{}" status-code=200

# 常见活动广告素材目录
^https?:\/\/swdlcdn\.eastmoney\.com\/(?:app\/)?(?:advert|advertise|advertisement)\/ data-type=tiny-gif status-code=200

# Choice 组件启动广告
^https?:\/\/choicegw2\.eastmoney\.com\/ads\/userauth\/api\/Ad\/GetLaunchAd(?:\?.*)?$ data-type=text data="{}" status-code=200

# 客户端下发的启动页及活动图片
^https?:\/\/j5\.dfcfw\.com\/WG\/(?:appconf|conf)\/202[0-9]{5}\/.*\.(?:png|jpe?g|gif|webp)(?:\?.*)?$ data-type=tiny-gif status-code=200

# > 京东去广告
# 热词、站点拉取、首页推荐、开屏和运营广告位。
^https:\/\/api\.m\.jd\.com\/client\.action\?functionId=(searchBoxWord|stationPullService|uniformRecommend[06]|homeAreaPop|home_launchConfig|lite_advertising|queryMaterialAdverts|smart_delivery_strategy)(?:&.*)?$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

# > 金十数据去广告（强力版）
# 开屏广告及应用内广告卡片
^https:\/\/jad-api\.jin10\.com\/ad[0-9]\/ data-type=text data="{}" status-code=200 header="Content-Type: application/json"

# 侧滑页、横幅及浮窗广告配置
^https:\/\/common-open-api\.jin10\.com\/configuration\/getById\?id=1493$ data-type=text data="{}" status-code=200 header="Content-Type: application/json"

# 搜索与首页热榜中的推广内容
^https:\/\/search-open-api\.jin10\.com\/search\/getHotWords(?:\?.*)?$ data-type=text data="{}" status-code=200 header="Content-Type: application/json"
^https:\/\/cdn\.jin10\.com\/json\/index\/hits_rank\.json\?(?:.*)?$ data-type=text data="{}" status-code=200 header="Content-Type: application/json"
^https:\/\/[0-9a-z]+\.z3c\.jin10\.com\/api\/home\/search\/hot(?:\?.*)?$ data-type=text data="{}" status-code=200 header="Content-Type: application/json"

# 未读消息区域的广告入口
^https:\/\/jad-api\.jin10\.com\/mult\/list_unread\?(?:.*)?$ data-type=text data="{}" status-code=200 header="Content-Type: application/json"

# > 美团去广告（稳定增强版）
# 美团外卖开屏与启动广告。
^https?:\/\/wmapi\.meituan\.com\/api\/v\d+\/(?:loadInfo|openscreen|startpicture)(?:\?.*)?$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

# 广告下发、首页弹窗、营销卡位与订单详情页推荐。
^https?:\/\/portal-portm\.meituan\.com\/horn_ios\/(?:mergeRequest)?(?:\?.*)?$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https?:\/\/mall\.meituan\.com\/api\/c\/homepage\/(?:splash|bubble\/operate\/info)(?:\?.*)?$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https?:\/\/cdb\.meituan\.com\/marketing\/source\/getPageSlotList(?:\?.*)?$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https?:\/\/sqt\.meituan\.com\/s\/gateway\/mweb\/api\/marketingResource\/show(?:\?.*)?$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https?:\/\/apimobile\.meituan\.com\/group\/v\d+\/recommend\/unity\/recommends(?:\?.*)?$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

# 明确的广告图片、横幅与灵珑广告素材；不拦截通用商品/门店 CDN。
