#!name=滴滴出行去广告
#!desc=仅移除开屏广告数据，保留其他页面、活动内容和出行功能；需要开启 MITM 与 Body Rewrite。
#!author=Havoooc
#!category=去广告
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/DiDi.png
#!openUrl=https://apps.apple.com/app/id554499054
#!date=2026-10-19
# 活动接口也承载非开屏内容，仅删除已知开屏字段，不整条拦截。
# 字段依据：https://github.com/blackmatrix7/ios_rule_script/discussions/354
# 字段缺失或响应结构不符时保留原数据。

[Body Rewrite]
http-response-jq ^https:\/\/res\.xiaojukeji\.com(?::443)?\/resapi\/activity\/(?:mget|xpget)(?:\?|$) 'if (.data | type) == "object" then del(.data.pas_start_page) else . end'

[MITM]
hostname = %APPEND% res.xiaojukeji.com
