#!name=米家去广告
#!desc=移除米家开屏、首页轮播及“我的”页面推广；仅匹配明确广告接口。
#!author=Havoc
#!homepage=https://github.com/Havoooc/surge-rules/tree/loon
#!openUrl=https://apps.apple.com/app/id957323480
#!icon=https://is1-ssl.mzstatic.com/image/thumb/Purple221/v4/0f/d2/a7/0fd2a748-426f-2ca4-a4dc-ccb314525ab1/AppIcon-0-0-1x_U007emarketing-0-8-0-sRGB-0-85-220.png/512x512bb.jpg
#!tag=去广告
#!loon_version=3.5.1(978)
#!date=2026-10-20
# 来源：Surge 全能合集 modules/mijia.sgmodule，03683bf。

[Rule]
DOMAIN,sdkconfig.ad.xiaomi.com,REJECT

[Rewrite]
# 首页横幅、轮播、“我的”推广及开屏配置返回空 JSON 对象。
request if ${url} ~= /^https?:\/\/home\.mi\.com\/cgi-op\/api\/v\d+\/recommendation\/(?:banner|carousel\/banners|myTab|openingBanner)(?:\?.*)?$/ then reject_dict(200)
# 实时开屏资源。
request if ${url} ~= /^https?:\/\/home\.mi\.com\/cgi-op\/api\/v\d+\/resource\/realtime\/openingBanner(?:\?.*)?$/ then reject_dict(200)

[Mitm]
hostname = home.mi.com
