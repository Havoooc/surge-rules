#!name=东方财富去广告
#!desc=拦截东方财富开屏、活动素材和广告追踪；首次启用后建议清理广告缓存并冷启动 App。
#!author=Havoc
#!homepage=https://github.com/Havoooc/surge-rules/tree/loon
#!icon=https://is1-ssl.mzstatic.com/image/thumb/Purple211/v4/80/c7/51/80c75169-8b9d-602a-7c4d-c356bf456282/AppIcon-0-0-1x_U007ephone-0-11-0-0-sRGB-85-220.png/512x512bb.jpg?v=eastmoney-20260807
#!tag=去广告
#!loon_version=3.5.1(978)
#!date=2026-10-20
# 来源：Surge 全能合集 modules/eastmoney-adblock.sgmodule，03683bf。
# 原 Map Local 转为 Loon 原生 Rewrite，不依赖远程脚本。

[Rule]
DOMAIN,emdcadvertise.eastmoney.com,REJECT
DOMAIN,emdcadvertisepj.eastmoney.com,REJECT
DOMAIN,emdcadvise.eastmoney.com,REJECT
DOMAIN,bduserlog.eastmoney.com,REJECT
DOMAIN,js4.eastmoney.com,REJECT
DOMAIN,same.eastmoney.com,REJECT
DOMAIN,cp2.eastmoney.com,REJECT

[Rewrite]
# 广告素材与 Choice 启动广告返回空 JSON 对象。
request if ${url} ~= /^https?:\/\/swdlcdn\.eastmoney\.com\/app\/adimg\// then reject_dict(200)
request if ${url} ~= /^https?:\/\/choicegw2\.eastmoney\.com\/ads\/userauth\/api\/Ad\/GetLaunchAd(?:\?.*)?$/ then reject_dict(200)
# 图片素材返回 1×1 GIF，与原 tiny-gif 规则对应。
request if ${url} ~= /^https?:\/\/swdlcdn\.eastmoney\.com\/(?:app\/)?(?:advert|advertise|advertisement)\// then reject_img(200)
request if ${url} ~= /^https?:\/\/j5\.dfcfw\.com\/WG\/(?:appconf|conf)\/202[0-9]{5}\/.*\.(?:png|jpe?g|gif|webp)(?:\?.*)?$/ then reject_img(200)

[Mitm]
hostname = swdlcdn.eastmoney.com, choicegw2.eastmoney.com, j5.dfcfw.com
