#!name=国内银行 VPN 兼容
#!desc=兼容部分银行代理环境检测，改善平安与招行的 Fake-IP 兼容；不解密银行流量，不能隐藏系统 VPN 状态。
#!author=Havoc
#!homepage=https://github.com/Havoooc/surge-rules/tree/loon
#!tag=网络兼容
#!loon_version=3.5.1(978)
#!date=2026-10-20
# 来源：Surge 全能合集 modules/bank-vpn-compat.sgmodule，03683bf。
# Loon 插件列表参数由客户端追加合并，无需 Surge 的 %APPEND% 标记。

[General]
# 绕过 HTTP Proxy；不扩大为整个 TUN 的绕过范围。
skip-proxy = www.baidu.com, yunbusiness.ccb.com, www.abchina.com.cn, login-service.mobile-bank.psbc.com, mobile-bank.psbc.com, mbank.psbc.com, *.bankcomm.com, *.ccb.com, *.boc.cn
# 返回真实 IP；这些域名仍按主配置分流，不强制直连。
real-ip = easy-login.10099.com.cn, id6.me, open.e.189.cn, *.pingan.com.cn, *.cmbchina.com

[Rule]
# 农业银行代理环境探测接口。
DOMAIN,msmp.abchina.com.cn,REJECT

# 本插件不配置 MitM，不读取或修改银行业务数据。
# 部分银行直接读取系统 VPN 状态，域名规则不能保证绕过检测。
# 如仍提示 VPN，可使用 iOS 自动化，在打开银行 App 时关闭 Loon。
